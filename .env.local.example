# Copy to .env.local and fill in.

# API base URL (NestJS backend)
NEXT_PUBLIC_API_URL=https://api.ranganijewelry.com/api/v1

# Sent as the x-tenant-id header on every API request
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001

# Storefront origin, used for "View on site" links
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
